{% use 'form_div_layout.html.twig' %}

{% block consent_category_row %}{{ form_widget(form) }}{% endblock %}
{% block consent_vendor_row %}{{ form_widget(form) }}{% endblock %}

{% block consent_category_widget %}
    {% set category = form.vars.data.name %}
    {% set title_key = 'cookie_consent.' ~ category ~ '.title' %}
    {% set description_key = 'cookie_consent.' ~ category ~ '.description' %}
    {% set title = title_key|trans({}, 'CookieConsentBundle') %}
    {% set description = description_key|trans({}, 'CookieConsentBundle') %}
    <div {{ block('widget_container_attributes') }}>
        <div class="cookie-consent__category-heading">
            <label for="{{ form.consentGiven.vars.id }}" class="cookie-consent__category-title">{{ title == title_key ? category|replace({'_': ' ', '-': ' '})|title : title }}</label>
            <span class="cookie-consent__switch">
                {{ form_widget(form.consentGiven, {attr: {class: 'cookie-consent__checkbox'}}) }}
                <span class="cookie-consent__switch-track" aria-hidden="true"></span>
            </span>
        </div>
        {% if description != description_key and description is not empty %}
            <p class="cookie-consent__description">{{ description }}</p>
        {% endif %}
        {{ form_widget(form.vendors) }}
        {{ form_rest(form) }}
    </div>
{% endblock %}

{% block consent_vendor_widget %}
    {% set vendor = form.vars.data.name %}
    {% set title_key = 'cookie_consent.vendors.' ~ vendor ~ '.title' %}
    {% set description_key = 'cookie_consent.vendors.' ~ vendor ~ '.description' %}
    {% set title = title_key|trans({}, 'CookieConsentBundle') %}
    {% set description = description_key|trans({}, 'CookieConsentBundle') %}
    <div {{ block('widget_container_attributes') }}>
        <div class="cookie-consent__vendor-copy">
            <label for="{{ form.consentGiven.vars.id }}">{{ title == title_key ? vendor|replace({'_': ' ', '-': ' '})|title : title }}</label>
            {% if description != description_key and description is not empty %}
                <p class="cookie-consent__description">{{ description }}</p>
            {% endif %}
        </div>
        <span class="cookie-consent__switch">
            {{ form_widget(form.consentGiven, {attr: {class: 'cookie-consent__checkbox'}}) }}
            <span class="cookie-consent__switch-track" aria-hidden="true"></span>
        </span>
        {{ form_rest(form) }}
    </div>
{% endblock %}
