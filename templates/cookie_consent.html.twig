{% block form_themes %}
{% form_theme simple_form with ['@CookieConsent/form/cookie_consent_form_theme.html.twig'] only %}
{% form_theme detailed_form with ['@CookieConsent/form/cookie_consent_form_theme.html.twig'] only %}
{% endblock form_themes %}
{# @formatter:off #}
{% if position == 'dialog' %} {# Wrap in dialog tag if position is dialog #}
<dialog class="cookie-consent-dialog" data-cookie-consent-theme="{{ theme|default('light') }}">
{% endif %}
{# @formatter:on #}

    <div class="cookie-consent cookie-consent--{{ position }}" data-cookie-consent-theme="{{ theme|default('light') }}">
        {% block pre_form %}
        {% endblock pre_form %}

            {% block header %}
                {% block title %}
                    <h3>{{ 'cookie_consent.title'|trans({}, 'CookieConsentBundle') }}</h3>
                {% endblock title %}

                {% block intro %}
                    <p>{{ 'cookie_consent.intro'|trans({}, 'CookieConsentBundle')|raw }}</p>
                {% endblock intro %}

                {% block read_more %}
                    {% if read_more_route %}
                        <a href="{{ path(read_more_route) }}">{{ 'cookie_consent.read_more'|trans({}, 'CookieConsentBundle') }}</a>
                    {% endif %}
                {% endblock read_more %}
            {% endblock header %}

        <section class="cookie-consent-simple">
            {{ form_start(simple_form, {'attr': {'class': 'cookie-consent__form js-consent-simple-form'}}) }}

            <div class="cookie-consent__actions">
            {% for child in simple_form %}
                {{ form_widget(child) }}
            {% endfor %}

            {{ form_rest(simple_form) }}

            <button type="button" class="cookie-consent__btn cookie-consent__settings js-show-settings" aria-expanded="false">{{ 'cookie_consent.cookie_settings_button'|trans({}, 'CookieConsentBundle') }}</button>

            </div>
            {{ form_end(simple_form) }}
        </section>

        <section class="cookie-consent-detail" style="display: none;" tabindex="-1">
            <button type="button" class="cookie-consent__back js-hide-settings">{{ 'cookie_consent.hide_details'|trans({}, 'CookieConsentBundle') }}</button>
            {% block necessary_cookies %}
                {% if necessary_cookies|default([]) is not empty %}
                    <section class="cookie-consent__necessary">
                        <h3>{{ 'cookie_consent.required_cookies.title'|trans({}, 'CookieConsentBundle') }}</h3>
                        <p>{{ 'cookie_consent.required_cookies.description'|trans({}, 'CookieConsentBundle') }}</p>
                        <p class="cookie-consent__always-active">{{ 'cookie_consent.required_cookies.always_active'|trans({}, 'CookieConsentBundle') }}</p>
                        <dl>
                            {% for cookie in necessary_cookies %}
                                <dt>{{ cookie.name|trans({}, 'CookieConsentBundle') }}</dt>
                                <dd>{{ cookie.description|trans({}, 'CookieConsentBundle') }}</dd>
                            {% endfor %}
                        </dl>
                    </section>
                {% endif %}
            {% endblock %}
            {{ form_start(detailed_form, {'attr': {'class': 'cookie-consent__form'}}) }}

            {{ form_widget(detailed_form.categories) }}
            <div class="cookie-consent__actions">
                {{ form_widget(detailed_form.save_consent_settings) }}
                {{ form_widget(detailed_form.accept_all) }}
                {% if detailed_form.reject_all is defined %}{{ form_widget(detailed_form.reject_all) }}{% endif %}
            </div>

            {{ form_rest(detailed_form) }}

            {{ form_end(detailed_form) }}
        </section>

        {% block post_form %}
        {% endblock post_form %}
    </div>

{# @formatter:off #}
{% if position == 'dialog' %}
</dialog>
{% endif %}
{# @formatter:on #}

{% block scripts %}
    <script type="module" src="{{ asset('bundles/cookieconsent/js/cookie-consent.min.js') }}"></script>
{% endblock scripts %}